[Unit]
Description=Cloud MCP Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cloud-mcp-server
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/cloud-mcp-server/.venv/bin/uvicorn mcp_server.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips="*"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
