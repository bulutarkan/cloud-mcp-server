# Public URL of your MCP server, e.g. https://mcp.yourdomain.com
BASE_URL=https://mcp.example.com

# Protects the /api/* REST endpoints used by Custom GPT Actions.
# Generate: openssl rand -hex 32
MCP_API_KEY=replace_with_a_long_random_api_key

# OAuth settings for MCP clients that use /mcp directly.
# Generate both secrets with: openssl rand -hex 32
OAUTH_CLIENT_ID=chatgpt-mcp-client
OAUTH_CLIENT_SECRET=replace_with_oauth_client_secret
OAUTH_MASTER_PASSWORD=replace_with_master_password_for_authorization_page
OAUTH_REDIRECT_URIS=https://chatgpt.com/aip/mcp/oauth/callback

# Server behavior
MCP_SERVER_NAME=cloud-mcp-server
SERVER_HOME=/home/ubuntu
SHARED_DIR=/home/ubuntu/Shared
RATE_LIMIT_PER_MINUTE=1000
DEFAULT_COMMAND_TIMEOUT_S=120
MAX_COMMAND_TIMEOUT_S=600
MAX_OUTPUT_CHARS=100000

# HTTP request tool safety. Use * for open access, or comma-separated host suffixes.
HTTP_ALLOWLIST=*
HTTP_HTTPS_ONLY=false
HTTP_MAX_RESPONSE_BYTES=5000000
HTTP_TIMEOUT_S=60

# Optional proxy integrations. Leave empty if you do not use them.
WP_MCP_URL=
WP_MCP_USERNAME=
WP_MCP_PASSWORD=
ZOHO_MCP_URL=
EXA_MCP_URL=https://mcp.exa.ai/mcp
TAVILY_MCP_URL=
N8N_MCP_URL=
